# ── Required ─────────────────────────────────────────────────────────────────
# Generate a strong random secret for JWT tokens.
# On Linux/Mac: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string


# ── Supabase (Authentication & Remote DB) ──────────────────────────────────────
# Find these in your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key


# ── Optional: HuggingFace (only needed for Moondream2 fallback) ───────────────
# Free token at https://huggingface.co/settings/tokens
# NOT needed if you are using Ollama (recommended).
# HF_TOKEN=hf_...

# ── Optional: Ollama server URL (default: http://localhost:11434) ─────────────
# Change this if Ollama is running on a different host or port.
# OLLAMA_URL=http://localhost:11434

# ── Optional: Ollama model override (default: llava-phi3) ───────────────────
# OLLAMA_MODEL=llava-phi3

# ── Optional: Ollama chat model for NutriBot (default: same as OLLAMA_MODEL) ──
# A text-only model is faster for chat (e.g. phi3, llama3.2:1b)
# OLLAMA_CHAT_MODEL=phi3

# ── Required in production: URL of the LLM inference server (llm/Llm_server.py) ──
# backend/App.py proxies /api/ai/chat, /api/ai/analyze, /api/ai/analyze/stream,
# and /api/ai/analyze-menu to this URL. If this is NOT set on Render, the backend
# silently falls back to http://localhost:5002 (unreachable in production), every
# LLM call fails, and the app falls back to generic canned replies / no photo
# scanning — with no visible error to the user.
# Local dev:  LLM_SERVER_URL=http://localhost:5002
# Production: LLM_SERVER_URL=https://energyvenom-nutritrack-llm.hf.space
LLM_SERVER_URL=http://localhost:5002

# ── Optional: Database (default: SQLite for local dev) ───────────────────────
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/nutritrack

# ── Optional: Frontend URL for CORS (needed in production) ───────────────────
# FRONTEND_URL=https://your-app.render.com
# ── Optional: Error tracking (Sentry) ──────────────────────────────────────
# Free tier at https://sentry.io — catches exceptions in production instead
# of them only showing up in Render logs. App runs fine without this set.
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ── Optional: Gemini fast-path for AI food scanning ────────────────────────
# If set, /api/ai/analyze tries Google's Gemini 1.5 Flash first (faster)
# before falling back to LLM_SERVER_URL above. This calls a paid Google API
# and sends user food photos to Google — only set this if you've made that
# tradeoff deliberately. Rate-limited to 10/min and 300/day per IP in code,
# but for real cost protection set a budget alert on the key in Google
# Cloud Console (Billing -> Budgets & alerts) — app-level limits are not a
# substitute for that.
# GEMINI_API_KEY=your-gemini-api-key