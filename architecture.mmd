graph TD
    subgraph Frontend ["Tier 1: Frontend (User Interface)"]
        UI[Vanilla JS Web App]
        Cam[Camera / File Upload]
        Dash[Nutrition Dashboard]
    end

    subgraph Backend ["Tier 2: Backend (Flask / Application Layer)"]
        API[App.py / Flask API]
        RAG[RAG Logic / In-Memory Dict Lookup]
        Router[Request Router]
    end

    subgraph AI ["Tier 3: AI Inference & Data Layer"]
        SigLIP[SigLIP Vision Classifier\nFast Zero-Shot Check]
        LLM[Moondream/Ollama LLM\nHeavy Fallback Engine]
        DB[(NUTRITION_DB\nUSDA Factual Macros)]
    end

    %% Flow of data
    UI -->|1. Uploads Food Image| API
    API -->|2. Image sent to AI Engine| SigLIP
    SigLIP -->|3a. Perfect Match| DB
    SigLIP -->|3b. Unsure Match| LLM
    
    LLM -->|4. Guesses Food Name| RAG
    RAG <-->|5. Fuzzy String Match| DB
    
    DB -->|6. Factual Macros Returned| API
    API -->|7. Final JSON Payload| Dash

    classDef frontend fill:#3498db,stroke:#2980b9,stroke-width:2px,color:white;
    classDef backend fill:#2ecc71,stroke:#27ae60,stroke-width:2px,color:white;
    classDef data fill:#9b59b6,stroke:#8e44ad,stroke-width:2px,color:white;

    class UI,Cam,Dash frontend;
    class API,RAG,Router backend;
    class SigLIP,LLM,DB data;
