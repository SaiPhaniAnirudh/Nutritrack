# ──────────────────────────────────────────────────────────────────────────────
#  docker/Dockerfile.api  —  NutriTrack Flask REST API (backend/App.py)
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend + frontend (backend/App.py serves frontend/index.html as static)
COPY backend/ ./backend/
COPY frontend/ ./frontend/

RUN mkdir -p backend/instance

EXPOSE 5000

CMD ["sh", "-c", "gunicorn -c gunicorn.conf.py --chdir backend App:app"]

