FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    procps \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama CLI & runner via official script
RUN curl -fsSL https://ollama.com/install.sh | sh

# Set environment variables
ENV OLLAMA_HOST=127.0.0.1:11434
ENV OLLAMA_URL=http://127.0.0.1:11434
ENV OLLAMA_MODEL=llava-phi3
ENV HOME=/tmp

# Create app directory
WORKDIR /app

# Python deps — only what Llm_server.py actually needs
RUN pip install --no-cache-dir \
    flask==3.0.3 \
    flask-cors==4.0.1 \
    flask-limiter==3.5.0 \
    python-dotenv==1.0.1 \
    requests==2.32.3 \
    Pillow \
    supabase

# Copy the AI server code and entrypoint script
COPY llm/Llm_server.py .
COPY docker/entrypoint.sh /app/entrypoint.sh

# Give execution permissions to the entrypoint
RUN chmod +x /app/entrypoint.sh

# Expose Hugging Face default port
EXPOSE 7860

# Run entrypoint
ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
