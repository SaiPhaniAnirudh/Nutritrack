{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|manifest\\.json|icons/|App\\.js|Style\\.css|Foods\\.js|i18n\\.js).*)",
      "destination": "/index.html"
    }
  ]
}